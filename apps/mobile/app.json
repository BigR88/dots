{
  "expo": {
    "name": "dots",
    "slug": "dots",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dots",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.dots.frankfurt",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "de",
        "CFBundleLocalizations": ["de"]
      }
    },
    "android": {
      "package": "app.dots.frankfurt",
      "adaptiveIcon": {
        "backgroundColor": "#6C5CFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#6C5CFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "dots nutzt deinen Standort nur, um dir Events in deiner Nähe zu zeigen und Entfernungen anzuzeigen.",
          "locationAlwaysAndWhenInUsePermission": "dots nutzt deinen Standort nur, um dir Events in deiner Nähe zu zeigen und Entfernungen anzuzeigen."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "dots braucht Zugriff auf deine Fotos, damit du ein Profilbild auswählen kannst.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
