# Kopiere nach .env und fülle aus, um echtes Supabase-Backend zu nutzen.
# Ohne diese Variablen läuft die App im Demo-Modus (lokale Fixtures).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Dev: Login-Gate überspringen (greift NUR in Dev-Builds, nie im Release).
# EXPO_PUBLIC_AUTH_DISABLED=1
